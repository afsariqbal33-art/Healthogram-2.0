rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Public social media media (posts, reels, stories) - Zero medical data allowed
    match /public_social/{userId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId)
        && request.resource.size < 50 * 1024 * 1024; // 50MB max
    }

    // Public marketplace product images
    match /public_marketplace/{sellerId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isOwner(sellerId)
        && request.resource.size < 10 * 1024 * 1024;
    }

    // STRICT PRIVATE SELLER VAULT: marketplace_private/{sellerUid}/**
    // 1. Seller Verification Documents: marketplace_private/{sellerUid}/verification/{documentId}
    //    Read: Document owner or authorized verification reviewers. Never public.
    // 2. Product Private Assets: marketplace_private/{sellerUid}/products/{productId}/images/{imageId}
    //    Read/Write: Seller owner only.
    // 3. Invoices & Reports: marketplace_private/{sellerUid}/invoices/{invoiceId}, reports/{reportId}
    //    Read/Write: Seller owner only.
    match /marketplace_private/{sellerUid}/{allPaths=**} {
      allow read: if isOwner(sellerUid)
        || (isAuthenticated() && request.auth.token.role in ['admin', 'owner', 'verification_reviewer']);
      allow write: if isOwner(sellerUid)
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/jpeg|image/png|image/webp|text/csv');
    }

    // Customer review images (Section 47)
    match /marketplace_reviews/{customerUid}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isOwner(customerUid)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg|image/png|image/webp');
    }

    // Customer return evidence photos (Section 45)
    match /marketplace_returns/{customerUid}/{allPaths=**} {
      allow read: if isAuthenticated() && (
        isOwner(customerUid) ||
        request.auth.token.role in ['seller', 'admin', 'owner']
      );
      allow write: if isOwner(customerUid)
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg|image/png|image/webp|application/pdf');
    }

    // STRICT ISOLATED PRIVATE MEDICAL VAULT: health_private/{patientUid}/**
    // 1. Never accessible publicly
    // 2. Direct client reads restricted to patient owner or verified clinicians with active grant
    // 3. Supported MIME types: PDF, JPG, PNG, HEIC (Max 20MB)
    match /health_private/{patientUid}/{allPaths=**} {
      allow read: if isOwner(patientUid);

      allow write: if (isOwner(patientUid) || isAuthenticated())
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/jpeg|image/png|image/heic');
    }

    // STRICT PRIVATE VERIFICATION DOCUMENT VAULT: verification_private/{userId}/{applicationId}/{documentId}
    // 1. Strictly isolated: NEVER accessible publicly or stored in /public/
    // 2. Client read: Only the document owner or authorized compliance reviewers
    // 3. Client write: Only the document owner
    // 4. File size: Max 25MB
    // 5. Allowed MIME types: PDF, JPG, JPEG, PNG, HEIC
    match /verification_private/{userId}/{applicationId}/{documentId} {
      allow read: if isOwner(userId)
        || (isAuthenticated() && request.auth.token.verificationRole in ['verification_reviewer', 'verification_manager', 'owner']);

      allow write: if isOwner(userId)
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/jpeg|image/png|image/heic');
    }

    // STRICT PRIVATE AI STUDIO STORAGE VAULT: ai_private/{uid}/**
    // 1. ai_private/{uid}/input/{jobId}/* - User uploads for AI processing
    // 2. ai_private/{uid}/output/{jobId}/* - Server-generated processed outputs
    // 3. ai_private/{uid}/thumbnail/{jobId}/* - Processed thumbnails
    // Access: Owner only. Max 25MB for images/docs, 100MB for video assistance.
    match /ai_private/{uid}/{allPaths=**} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg|image/png|image/webp|video/mp4|application/pdf|text/plain');
    }

    // STRICT PRIVATE MESSAGING & CALL MEDIA VAULT: messages_private/{conversationId}/{messageId}/**
    // Access: Authenticated users. Max 50MB.
    match /messages_private/{conversationId}/{messageId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg|image/png|image/webp|image/gif|video/mp4|video/webm|audio/mp4|audio/m4a|audio/mpeg|audio/ogg|audio/wav|application/pdf|text/plain');
    }

    // STRICT PRIVATE TRANSLATION STORAGE: translation_private/{uid}/**
    // Access: Account Owner only. Max 25MB for audio clips and transcripts.
    match /translation_private/{uid}/{allPaths=**} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('audio/mp4|audio/m4a|audio/mpeg|audio/ogg|audio/wav|application/json|text/plain');
    }

    // STRICT PRIVATE DELIVERY LOGISTICS VAULT: delivery_private/{deliveryId}/**
    // Access: Sender, Recipient or Delivery Dispatcher. Max 15MB.
    match /delivery_private/{deliveryId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg|image/png|image/webp|application/pdf');
    }

    // STRICT PRIVATE FINANCIAL REPORTS VAULT: financial_private/{reportId}/**
    // Access: Owner, Finance Admin, Auditor only. Server-authoritative write.
    match /financial_private/{reportId}/{allPaths=**} {
      allow read: if isAuthenticated() && request.auth.token.role in ['owner', 'finance_admin', 'auditor'];
      allow write: if false; // Server authoritative
    }
  }
}
