# ==============================================================================
# HEALTHOGRAM ENVIRONMENT CONFIGURATION TEMPLATE
# DO NOT COMMIT ACTUAL SECRETS TO VERSION CONTROL
# Copy this file to .env and provide your environment-specific credentials
# ==============================================================================

# Application Environment (development | staging | production)
ENVIRONMENT=development

# Firebase Project Configuration
FIREBASE_PROJECT_ID=healthogram-dev
FIREBASE_APP_ID=1:1234567890:android:abcdef1234567890
FIREBASE_API_KEY=AIzaSyPlaceholderClientApiKeyOnly
STORAGE_BUCKET=healthogram-dev.firebasestorage.app

# API & Gateway Endpoints
API_BASE_URL=https://api-dev.healthogram.com
CLOUD_FUNCTIONS_BASE_URL=https://us-central1-healthogram-dev.cloudfunctions.net

# AI Studio / Gemini Integration
AI_PROVIDER=gemini-3.8-flash
GEMINI_API_VERSION=v1beta

# Translation & Localization
TRANSLATION_PROVIDER=google-cloud-translation
DEFAULT_REGION=GCC
SUPPORTED_LOCALES=en,ar,fr,ur

# WebRTC & Signaling Service
RTC_PROVIDER=webrtc-healthogram
SIGNALING_WS_URL=wss://signaling-dev.healthogram.com

# Payment & Settlement Gateway
PAYMENT_PROVIDER=stripe-sandbox
CURRENCY=AED

# Logistics & Delivery Integration
DELIVERY_PROVIDER=mock-logistics-sandbox
DELIVERY_TRACKING_URL=https://delivery-sandbox.healthogram.com

# App Check / Play Integrity
APP_CHECK_DEBUG_TOKEN="debug-token-placeholder"
ENABLE_APP_CHECK="false"
