// Healthogram 2.3 Comprehensive Production Firestore Security Rules
// Version: 2.3.0
// Release: develop/healthogram-2-3

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isPlatformAdmin() {
      return isAuthenticated() && 
        (request.auth.token.admin == true || request.auth.token.role == 'PLATFORM_OWNER');
    }

    function isVerifiedHealthcare() {
      return isAuthenticated() && 
        (request.auth.token.accountType in ['Doctor', 'Clinic', 'Hospital', 'Laboratory']) &&
        request.auth.token.verified == true;
    }

    function hasValidConsent(patientUid, requiredScope) {
      return exists(/databases/$(database)/documents/health_access_grants/$(patientUid + '_' + request.auth.uid)) &&
        get(/databases/$(database)/documents/health_access_grants/$(patientUid + '_' + request.auth.uid)).data.isRevoked == false &&
        get(/databases/$(database)/documents/health_access_grants/$(patientUid + '_' + request.auth.uid)).data.expiresAt > request.time.toMillis() &&
        (requiredScope in get(/databases/$(database)/documents/health_access_grants/$(patientUid + '_' + request.auth.uid)).data.allowedScopes ||
         'SCOPE_FULL_CLINICAL_TIMELINE' in get(/databases/$(database)/documents/health_access_grants/$(patientUid + '_' + request.auth.uid)).data.allowedScopes);
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isPlatformAdmin();
    }

    // Health Passport Vault (Sovereign Patient Records)
    match /health_passports/{patientUid} {
      allow read: if isOwner(patientUid) || 
                  (isVerifiedHealthcare() && hasValidConsent(patientUid, 'SCOPE_FULL_CLINICAL_TIMELINE')) ||
                  isPlatformAdmin();
      allow write: if isOwner(patientUid);

      match /{subcollection}/{docId} {
        allow read: if isOwner(patientUid) || 
                    (isVerifiedHealthcare() && hasValidConsent(patientUid, subcollection)) ||
                    isPlatformAdmin();
        allow write: if isOwner(patientUid) || 
                     (isVerifiedHealthcare() && request.auth.token.accountType in ['Doctor', 'Hospital'] && hasValidConsent(patientUid, 'SCOPE_CONSULTATION_VISIT'));
      }
    }

    // QR Vault Tokens (Zero raw PHI, short lived)
    match /health_qr_sessions/{tokenId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.patientUid == request.auth.uid;
      allow update: if isAuthenticated(); // Redeem token
      allow delete: if false; // Immutable audit preservation
    }

    // Health Access Grants & Audit Logs
    match /health_access_grants/{grantId} {
      allow read: if isAuthenticated() && (resource.data.patientUid == request.auth.uid || resource.data.accessorUid == request.auth.uid);
      allow create, update: if isAuthenticated() && request.resource.data.patientUid == request.auth.uid;
      allow delete: if false;
    }

    match /health_access_logs/{logId} {
      allow read: if isAuthenticated() && (resource.data.patientUid == request.auth.uid || isPlatformAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if false; // Strictly append-only
    }

    // Appointments (v2.3)
    match /appointments/{appointmentId} {
      allow read: if isAuthenticated() && 
                  (resource.data.patientUid == request.auth.uid || resource.data.doctorUid == request.auth.uid || isPlatformAdmin());
      allow create: if isAuthenticated() && request.resource.data.patientUid == request.auth.uid;
      allow update: if isAuthenticated() && 
                    (resource.data.patientUid == request.auth.uid || resource.data.doctorUid == request.auth.uid || isPlatformAdmin());
      allow delete: if false;
    }

    // Marketplace Products & Orders
    match /marketplace_products/{productId} {
      allow read: if true; // Public catalog
      allow write: if isAuthenticated() && 
                   (request.auth.token.marketplaceRole == 'SELLER' || isPlatformAdmin());
    }

    match /marketplace_orders/{orderId} {
      allow read: if isAuthenticated() && 
                  (resource.data.customerUid == request.auth.uid || resource.data.sellerUid == request.auth.uid || isPlatformAdmin());
      allow create: if isAuthenticated() && request.resource.data.customerUid == request.auth.uid;
      allow update: if isAuthenticated() && 
                    (resource.data.customerUid == request.auth.uid || resource.data.sellerUid == request.auth.uid || isPlatformAdmin());
      allow delete: if false;
    }

    // Double-Entry Financial Ledger
    match /ledger_journal/{entryId} {
      allow read: if isPlatformAdmin();
      allow write: if isPlatformAdmin(); // Only authorized backend functions/workers
    }
  }
}
